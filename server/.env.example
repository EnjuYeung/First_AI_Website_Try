ADMIN_USER=admin
ADMIN_PASS=replace-with-a-strong-password
JWT_SECRET=replace-with-a-long-random-secret
DATA_ENCRYPTION_KEY=replace-with-output-of-openssl-rand-base64-32

# Optional
PORT=3001
# Required for Telegram callback buttons in production, e.g. https://subm.example.com
PUBLIC_BASE_URL=
NOTIFY_INTERVAL_MS=600000
# IANA timezone used for billing dates and reminders. Defaults to Asia/Shanghai.
TIMEZONE=Asia/Shanghai
# Maximum uploaded wallpaper size in bytes. Defaults to 8 MiB.
MAX_WALLPAPER_BYTES=8388608

# Comma-separated exact browser origins. Defaults cover the bundled production
# domain plus localhost/127.0.0.1 on ports 3000, 3001, and 5173.
# ALLOWED_ORIGINS=https://subm.example.com

# Express trust proxy setting. The default trusts loopback and private networks
# for the bundled Nginx -> backend Compose topology.
# TRUST_PROXY=loopback, linklocal, uniquelocal
